# Absolute (or relative-to-project) path to the folder containing your videos.
# Sub-folders are scanned recursively. Defaults to "./videos" if unset.
VIDEO_DIR=./videos

# Optional: path to ffmpeg/ffprobe binaries if not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Required. Login is mandatory — every page and API route is locked behind
# these credentials, with no way to disable it. Set at least one pair below,
# then restart the server.
#
# GUEST account: normal browsing/playback only. No admin nav, no folder
# management tools of any kind — same experience as before.
#
# ADMIN (Super Admin) account: everything the guest can do, PLUS the
# "Manage" tab — a folder-tree view of the whole library with rename,
# delete, move-between-folders and reorder controls. Only this account
# can see or use that tab; the underlying /api/manage/* routes reject
# any non-admin session too.
GUEST_USER_NAME=Guest
GUEST_USER_PASSWORD=00000000
ADMIN_USER_NAME=Riyaz
ADMIN_USER_PASSWORD=12345678
