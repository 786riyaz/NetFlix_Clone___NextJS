# Absolute (or relative-to-project) path to the folder containing your videos.
# Sub-folders are scanned recursively. Defaults to "./videos" if unset.
VIDEO_DIR=./videos
# Optional: path to ffmpeg/ffprobe binaries if not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Required. Login is mandatory — every page and API route is locked behind
# credentials, with no way to disable it. There are two roles:
#
# Guest — can browse, search, and play videos. No file management.
# Admin — everything guest can do, plus rename/move/delete/optimize and
#         changing the library folder.
#
# Set the role(s) you want to offer, then restart the server. Especially
# important if you expose this via a public tunnel.
GUEST_USER_NAME=Guest
GUEST_USER_PASSWORD=00000000
ADMIN_USER_NAME=Riyaz
ADMIN_USER_PASSWORD=12345678