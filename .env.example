# Absolute (or relative-to-project) path to the folder containing your videos.
# Sub-folders are scanned recursively. Defaults to "./videos" if unset.
VIDEO_DIR=./videos
# Optional: path to ffmpeg/ffprobe binaries if not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Strongly recommended if you expose this via a public tunnel (VS Code
# port forwarding, ngrok, etc). Without it, anyone with the link can browse
# and stream files from anywhere on this machine. Set any password:
# APP_PASSWORD=changeme